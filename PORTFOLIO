<title>RR Martinez Montoya | Developer Portfolio</title>

<style>
:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --light-blue: #eff6ff;
    --background: #f8fafc;
    --white: #ffffff;
    --text: #111827;
    --muted: #64748b;
    --border: #e2e8f0;
    --shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
}

/* NAVIGATION */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
}

.nav-container {
    max-width: 1150px;
    margin: auto;
    padding: 17px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--primary);
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    font-size: 14px;
    font-weight: 600;
    color: #334155;
    transition: 0.2s;
}

.nav-links a:hover {
    color: var(--primary);
}

.menu-toggle {
    display: none;
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
    color: var(--text);
}

/* GENERAL */

.container {
    max-width: 1150px;
    margin: auto;
    padding: 0 25px;
}

section {
    padding: 85px 0;
}

.section-heading {
    margin-bottom: 40px;
}

.section-heading .eyebrow {
    color: var(--primary);
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 34px;
    margin-top: 8px;
    letter-spacing: -1px;
}

.section-heading p {
    color: var(--muted);
    max-width: 650px;
    margin-top: 10px;
}

/* HERO */

.hero {
    padding: 110px 0 100px;
    background:
        radial-gradient(circle at 85% 20%, #dbeafe 0, transparent 30%),
        linear-gradient(135deg, #ffffff, #eff6ff);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 60px;
    align-items: center;
}

.hero-label {
    display: inline-block;
    background: #dbeafe;
    color: #1d4ed8;
    padding: 7px 13px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(38px, 6vw, 65px);
    line-height: 1.08;
    letter-spacing: -2.5px;
    margin-bottom: 20px;
}

.hero h1 span {
    color: var(--primary);
}

.hero-description {
    color: #475569;
    font-size: 17px;
    max-width: 650px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.btn {
    display: inline-block;
    padding: 13px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: 0.2s;
    cursor: pointer;
    border: 1px solid transparent;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-outline {
    border-color: #cbd5e1;
    background: white;
    color: var(--text);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.hero-card {
    background: white;
    padding: 30px;
    border-radius: 18px;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
}

.hero-card h3 {
    font-size: 17px;
    margin-bottom: 18px;
}

.hero-stat {
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.hero-stat:last-child {
    border: none;
}

.hero-stat strong {
    display: block;
    font-size: 23px;
    color: var(--primary);
}

.hero-stat span {
    font-size: 13px;
    color: var(--muted);
}

/* ABOUT */

.about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 45px;
}

.about-text p {
    color: #475569;
    margin-bottom: 16px;
}

.about-panel {
    background: white;
    border: 1px solid var(--border);
    padding: 28px;
    border-radius: 15px;
    box-shadow: var(--shadow);
}

.about-panel h3 {
    margin-bottom: 15px;
}

.about-item {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
}

.about-item:last-child {
    border: none;
}

.about-item strong {
    display: block;
    margin-bottom: 3px;
}

/* SKILLS */

.skills-section {
    background: white;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.skill-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    transition: 0.2s;
}

.skill-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: #bfdbfe;
}

.skill-icon {
    font-size: 27px;
    margin-bottom: 12px;
}

.skill-card h3 {
    font-size: 16px;
    margin-bottom: 9px;
}

.skill-card p {
    font-size: 13px;
    color: var(--muted);
}

/* PROJECTS */

.projects-section {
    background: var(--background);
}

.project-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
}

.filter-btn {
    border: 1px solid var(--border);
    background: white;
    padding: 9px 16px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
}

.filter-btn.active,
.filter-btn:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.project-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: 0.25s;
    display: flex;
    flex-direction: column;
}

.project-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.project-banner {
    height: 145px;
    background: linear-gradient(135deg, #dbeafe, #eff6ff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
}

.project-content {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-category {
    color: var(--primary);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.project-content h3 {
    font-size: 17px;
    margin-bottom: 10px;
}

.project-content p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 17px;
    flex: 1;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
}

.tag {
    background: #eff6ff;
    color: #1e40af;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
}

.project-details {
    border: none;
    background: none;
    color: var(--primary);
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    padding: 5px 0;
}

.project-details:hover {
    text-decoration: underline;
}

.project-card.hidden {
    display: none;
}

/* EXPERIENCE */

.experience-section {
    background: white;
}

.timeline {
    border-left: 2px solid #bfdbfe;
    padding-left: 28px;
    margin-left: 8px;
}

.timeline-item {
    position: relative;
    margin-bottom: 32px;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: -36px;
    top: 5px;
    height: 14px;
    width: 14px;
    background: var(--primary);
    border-radius: 50%;
    border: 3px solid white;
}

.timeline-item h3 {
    font-size: 17px;
}

.timeline-item .date {
    color: var(--primary);
    font-size: 12px;
    font-weight: 700;
    margin: 4px 0 8px;
}

.timeline-item p {
    color: var(--muted);
    font-size: 14px;
    max-width: 750px;
}

/* CONTACT */

.contact-section {
    background: linear-gradient(135deg, #eff6ff, #ffffff);
}

.contact-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 45px;
    box-shadow: var(--shadow);
    text-align: center;
    max-width: 800px;
    margin: auto;
}

.contact-card h2 {
    font-size: 32px;
    margin-bottom: 12px;
}

.contact-card p {
    color: var(--muted);
    margin-bottom: 25px;
}

.contact-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

/* FOOTER */

footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 25px;
    font-size: 13px;
}

footer span {
    color: #93c5fd;
}

/* MODAL */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(15, 23, 42, 0.7);
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.modal.show {
    display: flex;
}

.modal-content {
    background: white;
    border-radius: 15px;
    max-width: 600px;
    width: 100%;
    padding: 30px;
    position: relative;
    max-height: 85vh;
    overflow-y: auto;
}

.modal-content h2 {
    margin-bottom: 12px;
}

.modal-content p {
    color: #475569;
    margin-bottom: 15px;
}

.modal-content ul {
    padding-left: 20px;
    color: #475569;
    margin-bottom: 20px;
}

.modal-close {
    position: absolute;
    right: 18px;
    top: 12px;
    border: none;
    background: none;
    font-size: 27px;
    cursor: pointer;
    color: #64748b;
}

/* RESPONSIVE */

@media (max-width: 900px) {
    .hero-content,
    .about-grid {
        grid-template-columns: 1fr;
    }

    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 650px) {
    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 60px;
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 0;
        background: white;
        border-bottom: 1px solid var(--border);
        padding: 10px 25px;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links li a {
        display: block;
        padding: 12px 0;
    }

    .projects-grid,
    .skills-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 75px 0;
    }

    section {
        padding: 65px 0;
    }

    .section-heading h2 {
        font-size: 28px;
    }

    .contact-card {
        padding: 28px 20px;
    }
}
</style>
</head>

